# Polaris — root environment variables
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Loaded by docker-compose (env_file), so covers the full stack:
# API (FastAPI) + Portal (Next.js :3000) + Admin (Next.js :3001).

# ── Database ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Direct superuser DSN — migrations and BYPASSRLS seed scripts only.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-1-<region>.pooler.supabase.com:5432/postgres
# Dual asyncpg pools. polaris_anon = NOBYPASSRLS (RLS enforced). polaris_service = BYPASSRLS.
POLARIS_DB_URL_ANON=postgresql://polaris_anon.your-project-ref:PASSWORD@aws-1-<region>.pooler.supabase.com:5432/postgres
POLARIS_DB_URL_SERVICE=postgresql://polaris_service.your-project-ref:PASSWORD@aws-1-<region>.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Encryption ────────────────────────────────────────────────────────────────
# 32-byte hex: python -c "import nacl.utils; print(nacl.utils.random(32).hex())"
# Never regenerate after first prod deploy — all tenant_secrets become undecryptable.
POLARIS_KMS_KEY=

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=polaris-portal
JWT_LEEWAY_SECONDS=10

# ── Portal (Next.js :3000) ────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 48
NEXTAUTH_SECRET=
PORTAL_BASE_URL=https://portal.getpolaris.my
PORTAL_SESSION_MAX_AGE_S=2592000
# Public base URL of THIS api service — used to build the Telegram webhook URL at
# provisioning (setWebhook) + the website-widget embed snippet. Off-Meta channels.
PUBLIC_API_BASE_URL=https://api.getpolaris.my
# Optional override for the Telegram Bot API base (default https://api.telegram.org);
# point at a mock for E2E. Leave unset in real environments.
# TELEGRAM_API_BASE_URL=
# API-side copy of NEXTAUTH_SECRET — must match.
PORTAL_NEXTAUTH_SECRET=

# ── Admin (Next.js :3001) ─────────────────────────────────────────────────────
ADMIN_NEXTAUTH_URL=http://admin.localhost
# Generate: openssl rand -base64 48. Distinct from NEXTAUTH_SECRET.
ADMIN_NEXTAUTH_SECRET=
ADMIN_SESSION_MAX_AGE_S=86400
ADMIN_MAGIC_LINK_EXPIRY_MIN=10
ADMIN_MAGIC_LINK_REQUESTS_PER_HOUR=3
# /24 = tolerate same-LAN reconnect. 32 = exact IP match.
ADMIN_MAGIC_LINK_IP_BIND_PREFIX=24
# Caddy injects as X-Polaris-Caddy-Token. Required in prod. Generate: openssl rand -hex 32
ADMIN_CADDY_PROXY_TOKEN=

# ── Meta / WhatsApp ───────────────────────────────────────────────────────────
# WhatsApp SEND credentials are resolved PER-TENANT at reply time from
# tenant_channels.phone_number_id + tenant_secrets.meta_waba_access_token. Store
# each tenant's WABA token via Admin → Secrets. (ADR-066 removed the shared
# META_DEMO_* fallback — demo dispatch uses the gateway channel's own creds.)
# Main Meta (Facebook) app id — read ONLY by infra/deploy/register-meta-webhooks.sh
# to manage webhook subscriptions on the Meta App Dashboard. After the
# Chatwoot-native rehaul the API itself does NOT read META_APP_ID at runtime
# (inbound arrives via Chatwoot, not graph.facebook.com → meta_router). Leave
# blank if you manage subscriptions in the Meta App Dashboard manually.
META_APP_ID=
# Facebook App Settings → Basic → App Secret. Verifies HMAC on the WhatsApp + Messenger
# webhook deliveries that the Chatwoot fork RELAYS to Polaris (wa-status,
# meta-template-status, wa-account). Outbound Meta sends use per-tenant tokens.
META_APP_SECRET=
# Override Instagram-Login Graph base URL (E2E/dev only — leave unset in prod).
# META_INSTAGRAM_API_BASE_URL=https://graph.instagram.com
META_GRAPH_API_VERSION=v25.0
# Override Meta Graph API base URL (E2E/dev only — leave unset in prod).
# META_API_BASE_URL=https://graph.facebook.com

# ── Chatwoot ──────────────────────────────────────────────────────────────────
CHATWOOT_BASE_URL=https://chat.getpolaris.my
# Platform-wide agent-bot token (single token across all accounts).
CHATWOOT_BOT_ACCESS_TOKEN=
# User-level agent/admin token for contacts + conversation create (bot token rejected for these endpoints).
CHATWOOT_AGENT_API_TOKEN=
# HMAC secret the Chatwoot fork signs every agent-bot webhook with (X-Chatwoot-Signature).
# Polaris verifies it on POST /v1/webhooks/chatwoot — the PRIMARY (and only) inbound
# path after the Chatwoot-native rehaul. REQUIRED in non-local environments: the API
# REFUSES TO BOOT without it (boot guard in main.py). Generate: openssl rand -hex 32.
CHATWOOT_WEBHOOK_HMAC_SECRET=
CHATWOOT_API_TIMEOUT_S=8
CHATWOOT_API_MAX_RETRIES=2
# Ensures bot-handling/human-handling labels exist before applying them.
CHATWOOT_LABEL_AUTO_PROVISION=true
# Enables channel access-token AUTO-CAPTURE on channel-add (WhatsApp api_key,
# IG/Messenger page token) via the fork's GET /internal/inboxes/:id/token.
# MUST equal the Chatwoot fork's POLARIS_INTERNAL_TOKEN (set in the CW env file).
# Leave blank to disable — channel-add then returns token_captured=false and the
# admin rotates the secret manually via Admin → Secrets. Generate: openssl rand -hex 32
CHATWOOT_INTERNAL_TOKEN=
# Internal Rails hostname (docker network); override only if it differs.
CHATWOOT_INTERNAL_BASE_URL=http://chatwoot-rails:3000

# ── Easy!Appointments (EA) ────────────────────────────────────────────────────
EA_API_BASE_URL=https://calendar.getpolaris.my
# Customer-facing booking URL for bot reply links and the /b/{jti} redirect.
# Keep pointing to the public calendar domain even when EA_API_BASE_URL is
# overridden to the internal Docker host (http://ea-nginx:80) in prod.
EA_BOOKING_PUBLIC_URL=https://calendar.getpolaris.my
# Must match EA fork's config/polaris.php jwt.secret.
EA_JWT_SIGNING_SECRET=
EA_JWT_AUDIENCE=ea-fork
EA_JWT_ISSUER=polaris
EA_JWT_TTL_SECONDS=60
EA_API_TIMEOUT_S=8.0
EA_API_MAX_RETRIES=0
# Booking-via-EA-link binding (v2.1). Secrets fail closed on placeholder/empty.
BOOKING_BINDING_SECRET=
BOOKING_BINDING_TTL_SECONDS=3600
EA_WEBHOOK_HMAC_SECRET=
# Signs internal EA provisioning calls (admin "Create EA account" / delete). The
# EA fork verifies it against POLARIS_WEBHOOK_SECRET, which prod wires to
# EA_WEBHOOK_HMAC_SECRET (infra/docker-compose.prod.yml → ea-php-fpm), so set this
# to the SAME value as EA_WEBHOOK_HMAC_SECRET above. Missing/placeholder fails
# closed with EABookingConfigError before any HTTP call.
EA_PROVISIONING_HMAC_SECRET=
# GHCR push token (write:packages) — dev-box BUILD only. polaris-ea-fork/docker/build.sh
# reads it from here to `docker login` before pushing the EA image. NOT needed to run
# the app; the prod containers load this whole file via env_file, so LEAVE IT BLANK on
# the VPS (the VPS pulls images with deploy.env's separate read:packages token). Empty
# is fine on the build box too — then `docker login ghcr.io -u jiun01` manually.
GITHUB_TOKEN=

# ── AI / LLM ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
# E2E-only: true → classify_intent/generate_response return canned values and the
# inbound pipeline worker starts without a real ANTHROPIC_API_KEY (deterministic,
# offline, CI-runnable). Leave empty/false in staging + prod.
LLM_STUB_ENABLED=
# E2E-only: true → admin /cost endpoints return deterministic, month-aware,
# band-spread fixture data for seeded tenants instead of Grafana-Mimir zeros
# (no live Mimir locally). Leave empty/false in staging + prod.
COST_STUB_ENABLED=
# Must match the desktop ingestion app (knowledge_chunks.embedding = VECTOR(1024)).
# Locked to qwen/qwen3-embedding-8b by ADR-059 (MRL-truncated to 1024 via OpenRouter).
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
LLM_HAIKU_MODEL=claude-haiku-4-5-20251001
LLM_SONNET_MODEL=claude-sonnet-5
LLM_MAX_TOKENS_SIMPLE=500
LLM_MAX_TOKENS_MEDIUM=800
LLM_MAX_TOKENS_HARD=1000
LLM_CACHE_TTL=5m
CONVERSATION_HISTORY_MAX_MESSAGES=20
CONVERSATION_HISTORY_MAX_TOKENS=8000

# ── Inbound voice notes (Groq Whisper, Pro+ only) ─────────────────────────────
# Transcribes inbound voice notes (WA/IG/Messenger/Telegram) → text reply in the
# spoken language (EN/MS/ZH auto-detect). Get a key at https://console.groq.com/keys.
# Fails closed on placeholder/empty (no call to Groq with a junk key).
GROQ_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3
# Master switch. false → voice notes fall through to the media-only handoff path.
TRANSCRIPTION_ENABLED=true
# E2E-only: true → transcribe() returns a canned transcript and the pipeline boots
# without a real GROQ_API_KEY (deterministic, offline). Leave empty/false in prod.
TRANSCRIPTION_STUB_ENABLED=
TRANSCRIPTION_TIMEOUT_S=15.0
TRANSCRIPTION_MAX_DOWNLOAD_BYTES=26214400

# ── Knowledge Gap Detection (Ultra-only) ──────────────────────────────────────
# Logs questions the bot can't confidently answer → ranked gap themes on the
# Ultra dashboard. Both capture and dashboard gate on plan tier (Ultra/Enterprise,
# a code-default frozenset — not env-configurable).
# Master switch. false → no misses are logged at all.
KNOWLEDGE_GAP_CAPTURE_ENABLED=true
# rrf_score floor for a 'low_retrieval' miss; 0.0 = disabled (only no_retrieval +
# handoff fire) until the floor is tuned on real data.
KNOWLEDGE_GAP_RETRIEVAL_THRESHOLD=0.0

# ── Handoff ───────────────────────────────────────────────────────────────────
HANDOFF_PRIVATE_NOTE_MAX_LEN=4000
HANDOFF_BUSINESS_HOURS_GRACE_MIN=0
HANDOFF_RECOVERY_NOTE_TEMPLATE=(handoff requested at {ts} but the messaging inbox was unreachable: {reason} — agent please review)
MESSENGER_PROFILE_API_TIMEOUT_S=10

# ── Outbound / Broadcast ──────────────────────────────────────────────────────
BROADCAST_TICK_SECONDS=5
BROADCAST_BATCH_SIZE=50
BROADCAST_PER_RECIPIENT_TIMEOUT_SEC=8
BROADCAST_QUEUE_NAMESPACE=broadcast
BROADCAST_RECIPIENT_RETRY_MAX=3
BROADCAST_DRAIN_MAX_RUNTIME_SEC=1800
# Disable ONLY for sandbox testing — off in prod violates Meta policy.
BROADCAST_24H_WINDOW_CHECK_ENABLED=true
TEMPLATE_SUBMISSION_MAX_PER_DAY_PER_TENANT=50
AUDIENCE_CSV_MAX_ROWS=100000
AUDIENCE_CSV_MAX_BYTES=10485760
OPT_OUT_VIEWER_PAGE_SIZE=200
NOTIFICATIONS_PAGE_SIZE_MAX=50

# ── Flow runtime ──────────────────────────────────────────────────────────────
FLOW_RUNTIME_MAX_NODES_PER_RUN=500
FLOW_RUNTIME_MAX_TRANSITIONS_PER_RUN=200
FLOW_RUNTIME_STEP_TIMEOUT_SEC=30
FLOW_RUNTIME_DEFINITION_MAX_KB=512
FLOW_RUNTIME_VARS_MAX_KB=32
# LLM/RAG calls are real in simulator but Meta/Chatwoot dispatch is suppressed.
FLOW_RUNTIME_SIMULATOR_DRY_RUN=true
FLOW_TEMPLATES_SEED_ON_MIGRATE=true

# ── Email ─────────────────────────────────────────────────────────────────────
# Portal magic-link (NextAuth)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=Polaris <no-reply@getpolaris.my>
MAGIC_LINK_EXPIRY_MIN=15

# Portal invite emails (API-side)
PORTAL_INVITE_SMTP_HOST=
PORTAL_INVITE_SMTP_PORT=587
PORTAL_INVITE_SMTP_USER=
PORTAL_INVITE_SMTP_PASSWORD=
PORTAL_INVITE_SMTP_FROM=noreply@getpolaris.my
PORTAL_INVITE_SMTP_TIMEOUT_S=10.0
PORTAL_INVITE_EXPIRY_MINUTES=15

# Admin magic-link + platform alerts
ADMIN_EMAIL_SERVER_HOST=
ADMIN_EMAIL_SERVER_PORT=587
ADMIN_EMAIL_SERVER_USER=
ADMIN_EMAIL_SERVER_PASSWORD=
ADMIN_EMAIL_FROM=Polaris Admin <no-reply@getpolaris.my>
ADMIN_EMAIL_TO=ops@getpolaris.my

# ── Storage ───────────────────────────────────────────────────────────────────
INVOICE_PDF_BUCKET=polaris-invoices
SUPABASE_STORAGE_QUOTES_BUCKET=polaris-sales-quotes

# ── Hosting / Caddy ───────────────────────────────────────────────────────────
# bcrypt hash from `caddy hash-password`. Generate fresh for prod.
# IMPORTANT: Docker Compose v2+ expands $VAR in env_file values. Escape every
# $ in the hash with $$ so it survives. Example:
#   raw:    $2a$14$abcXYZ...
#   in .env: $$2a$$14$$abcXYZ...
CADDY_ADMIN_BASIC_AUTH_HASH=
# Internal docker-compose hostname for the API. Overrides POLARIS_API_BASE_URL server-side.
POLARIS_API_INTERNAL_URL=http://polaris-api:8000

# ── Prod compose — cross-stack infra (docker-compose.prod.yml) ────────────────
# Chatwoot Postgres password (prod only — dev uses trust auth).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CW_PG_PASSWORD=
# Chatwoot Redis password (separate Redis instance from Polaris).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CW_REDIS_PASSWORD=
# EA MySQL credentials — used by ea-mysql container in docker-compose.prod.yml.
# ea-php-fpm reuses EA_MYSQL_USER/PASSWORD as its DB_USER/DB_PASSWORD (the image
# self-generates config.php from env on boot — v1.6.0-r2+).
# Generate passwords: python -c "import secrets; print(secrets.token_urlsafe(24))"
EA_MYSQL_ROOT_PASSWORD=
EA_MYSQL_USER=eauser
EA_MYSQL_PASSWORD=
# EA app's own public base URL (written into config.php BASE_URL).
EA_PUBLIC_URL=https://calendar.getpolaris.my
# Run EA schema migrations automatically on container boot (false = migrate as an
# explicit step). Idempotent — applies only pending migrations.
EA_AUTO_MIGRATE=true
# Cloudflare Turnstile widget — shown on the public booking page. Leave empty to
# disable CAPTCHA (acceptable in early prod before going public).
# Get keys at: https://dash.cloudflare.com → Turnstile.
POLARIS_TURNSTILE_SITEKEY=
POLARIS_TURNSTILE_SECRET=
# CORS allowed origin for EA API responses. Must match the portal's public domain.
POLARIS_CORS_ORIGIN=https://portal.getpolaris.my
# Public base URL of the Polaris API. Portal/admin services override this in-compose
# with the internal hostname (http://polaris-api:8000); the EA fork reads this shared
# value to POST its signed appointment-confirm callback (/v1/webhooks/ea), signed with
# POLARIS_WEBHOOK_SECRET (= EA_WEBHOOK_HMAC_SECRET). EA egress is proven (Turnstile).
POLARIS_API_BASE_URL=https://api.getpolaris.my

# ── Observability ─────────────────────────────────────────────────────────────
POLARIS_ENV=local
ENVIRONMENT=local
LOG_LEVEL=INFO
SENTRY_DSN=
OTEL_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
OTEL_HEADERS=Authorization=Basic placeholder-base64-grafana-token
OTEL_SERVICE_NAME=polaris-api
# OTel resource attributes — groups polaris-api under the "polaris" namespace in
# Grafana Application Observability. Set as a container env override in
# docker-compose.prod.yml; documented here so new VPS deploys expect it.
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=polaris
GRAFANA_CLOUD_MIMIR_URL=
GRAFANA_CLOUD_MIMIR_TOKEN=
# USD→MYR conversion for the per-tenant cost dashboard. NOT a live FX feed —
# bump manually when the rate drifts materially.
USD_TO_MYR_RATE=4.15
# Human-facing dashboard deep-links for the System Health "Recent failures" tile
# (browser URLs an operator clicks). Distinct from the OTLP endpoint / Mimir / DSN
# above. Empty = the tile shows "APM links not configured".
GRAFANA_DASHBOARD_URL=
SENTRY_PROJECT_URL=
# Sentry API credentials for the System Health APM tile (optional).
# sentry_auth_token: user-auth token with project:read scope (Settings → Auth Tokens).
# Find sentry_org_slug and sentry_project_slug in your Sentry project URL:
#   https://sentry.io/organizations/<org-slug>/projects/<project-slug>/
# sentry_api_base: override only for self-hosted Sentry; leave default for sentry.io.
SENTRY_AUTH_TOKEN=placeholder-sentry-auth-token
SENTRY_ORG_SLUG=placeholder-org-slug
SENTRY_PROJECT_SLUG=placeholder-project-slug
SENTRY_API_BASE=https://sentry.io
# 0 = disabled. MYR threshold to fire Sentry fatal on all-tenant daily LLM spend.
POLARIS_PLATFORM_DAILY_SPEND_THRESHOLD_MYR=0.0

# ── Booking reminders (Phase 13) ─────────────────────────────────────────────
# Reminder worker tick interval and per-reminder send retry cap.
REMINDER_TICK_SECONDS=60
REMINDER_MAX_ATTEMPTS=3

# ── AI follow-ups (Phase 13) ─────────────────────────────────────────────────
# Follow-up worker tick interval and per-job send retry cap. The worker runs
# in-process via the API lifespan; these tune it (also used by the standalone
# scripts/run_followup_worker.py).
FOLLOWUP_TICK_SECONDS=60
FOLLOWUP_MAX_ATTEMPTS=3

# ── E2E / testing ─────────────────────────────────────────────────────────────
# Bearer token for /internal/e2e/* routes (only active when ENVIRONMENT=test).
POLARIS_E2E_INTERNAL_SECRET=
# E2E-only: true → mounts the /meta-mock capture router intercepting Meta Graph
# calls. Pair with META_API_BASE_URL=http://localhost:8000/meta-mock. Leave
# empty/false in staging + prod.
# META_MOCK_ENABLED=true
EA_BASE_URL=http://localhost:8090
EA_ADMIN_API_TOKEN=
PLAYWRIGHT_ADMIN_BASE_URL=http://admin.localhost
PLAYWRIGHT_ADMIN_HTTP_USER=
PLAYWRIGHT_ADMIN_HTTP_PASS=
PLAYWRIGHT_PORTAL_BASE_URL=http://localhost:3000
PLAYWRIGHT_ADMIN_STORAGE_STATE=./e2e/.auth/admin.json
ADMIN_MAILHOG_API_URL=http://localhost:8025
E2E_ADMIN_EMAIL=e2e-admin@polaris-local.dev
