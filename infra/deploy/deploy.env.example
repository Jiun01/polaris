# Polaris VPS deploy config — copy to deploy.env and fill in.
#   cp deploy.env.example deploy.env && $EDITOR deploy.env
# Sourced by vps-install.sh, vps-update.sh, and infra/build.sh (--deploy flag). deploy.env is gitignored.

# Where the deploy lives on the VPS. The monorepo is cloned to
# $DEPLOY_ROOT/polaris; the two fork-config files live as siblings
# ($DEPLOY_ROOT/polaris-cw-fork/.env and
#  $DEPLOY_ROOT/polaris-ea-fork/docker/nginx/nginx.conf) so the existing
# compose relative paths resolve without edits.
DEPLOY_ROOT=/opt

# Monorepo git remote + branch to deploy.
POLARIS_REPO_URL=https://github.com/Jiun01/polaris-private.git
POLARIS_BRANCH=main

# GHCR auth for pulling the private fork images. The script runs `docker login`
# with this token (a PAT with read:packages). Leave GITHUB_TOKEN empty to skip
# login if the box is already authenticated.
GHCR_USER=jiun01
GITHUB_TOKEN=

# EA fork branch the one-off nginx.conf is fetched from (install only).
EA_FORK_BRANCH=main

# Set to 1 to skip DB migrations (e.g. run them out-of-band).
SKIP_MIGRATIONS=0

# Set to 1 to force-refresh the EA shared volume on update even if auto-detect
# didn't see an image change (use if EA static assets look stale post-update).
FORCE_EA_REFRESH=0

# VPS SSH target — used by infra/build.sh --deploy to trigger vps-update.sh
# remotely after pushing images. Format: user@host or user@ip.
# Leave empty to skip the remote step (run vps-update.sh manually instead).
VPS_HOST=root@
