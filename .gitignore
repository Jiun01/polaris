# --- Secrets ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- ship.sh release pipeline (transient state + build logs) ---
infra/.ship-state.env
infra/.ship-logs/

# --- bot-reply E2E run artifact (transient; regenerated each run) ---
ops/e2e/bot_reply/last_run.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.uv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
build/
dist/
.python-version

# --- Node / pnpm ---
node_modules/
.pnpm-store/
*.log
npm-debug.log*
pnpm-debug.log*

# --- Next.js ---
.next/
out/
next-env.d.ts

# --- TypeScript ---
*.tsbuildinfo

# --- Generated TS shared types (regenerated from Pydantic) ---
# schema.json IS committed — it's the drift gate (CI: export.py --check).
# polaris-shared-types.ts is ALSO committed as of audit-batch-f-frontend
# (portal + admin now import real models from it) — regenerate via
# `make export-types` / `uv run python packages/shared-types/scripts/export.py`
# whenever a Pydantic model in packages/shared-types/python/ changes, and
# commit the diff (same discipline as schema.json).
packages/shared-types/typescript/*.tsbuildinfo

# --- Editor / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Docker ---
.docker/

# --- Misc ---
*.tmp
*.bak

# --- Local analysis reports (codemap-diff, harness audits) ---
# Per-run artifacts — not versioned
.reports/

# --- Local agent / session data (Claude Code, etc.) ---
# Per-developer harness state — never versioned.
.claude/

# Phase 4 PR-5 — eval run archives (per-run JSON, regenerated on every make eval)
benchmarks/runs/
benchmarks/prompts/

# Playwright E2E auth state — generated by global-setup.ts; never committed
apps/admin/e2e/.auth/
apps/portal/e2e/.auth/
# Local marketing-screenshot capture scratch output
apps/portal/e2e/.shots/
# Playwright report artifacts (local runs)
playwright-report/
test-results/

# VPS deploy config — contains GHCR token, never commit
infra/deploy/deploy.env
