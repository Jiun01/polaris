# Polaris v2 admin — environment variables
# Copy to `apps/admin/.env.local` and fill in real values. `.env.local` is gitignored.
# For docker-compose dev: most of these are overridden via the root `.env` + docker-compose env_file.

# ── NextAuth ──────────────────────────────────────────────────────────────────
ADMIN_NEXTAUTH_URL=http://localhost:3001
# Distinct from portal's NEXTAUTH_SECRET — prevents cross-app session replay.
# Generate: openssl rand -base64 48
ADMIN_NEXTAUTH_SECRET=
# Server-side internal URL for CSRF token fetch inside Docker network.
# Set to http://polaris-admin:3001 when running in docker-compose.
# NEXTAUTH_URL_INTERNAL=

# ── SMTP — magic-link delivery ────────────────────────────────────────────────
ADMIN_EMAIL_SERVER_HOST=
ADMIN_EMAIL_SERVER_PORT=587
ADMIN_EMAIL_SERVER_USER=
ADMIN_EMAIL_SERVER_PASSWORD=
ADMIN_EMAIL_FROM=Polaris Admin <no-reply@getpolaris.my>

# ── Auth controls ─────────────────────────────────────────────────────────────
ADMIN_MAGIC_LINK_EXPIRY_MIN=10
ADMIN_MAGIC_LINK_REQUESTS_PER_HOUR=3
# /24 = tolerate same-LAN re-connect. 32 = exact IP (strictest).
ADMIN_MAGIC_LINK_IP_BIND_PREFIX=24
ADMIN_SESSION_MAX_AGE_S=86400
# Shared secret Caddy injects as X-Polaris-Caddy-Token. Required in prod.
# Generate: openssl rand -hex 32
ADMIN_CADDY_PROXY_TOKEN=

# ── Polaris API ───────────────────────────────────────────────────────────────
POLARIS_API_BASE_URL=http://localhost:8000
# Server-side override for Docker internal network.
# POLARIS_API_INTERNAL_URL=http://polaris-api:8000

# ── Deploy ────────────────────────────────────────────────────────────────────
# Environment badge: prod (red) | staging (blue) | dev (grey). Falls back to NODE_ENV.
# NEXT_PUBLIC_DEPLOY_ENV=dev

# ── E2E / Playwright ──────────────────────────────────────────────────────────
# PLAYWRIGHT_ADMIN_BASE_URL=http://localhost:3001
# PLAYWRIGHT_ADMIN_STORAGE_STATE=e2e/.auth/admin.json
# PLAYWRIGHT_PORTAL_BASE_URL=http://localhost:3000
# Start via `docker compose --profile e2e up mailhog` then set this.
# ADMIN_MAILHOG_API_URL=http://localhost:8025
# Bearer token for /internal/e2e/* routes (ENVIRONMENT=test only).
# POLARIS_E2E_INTERNAL_SECRET=

# ── Observability ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_ENVIRONMENT=prod
