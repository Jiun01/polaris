# Polaris v2 portal — environment variables
# Copy to `apps/portal/.env.local` and fill in real values. `.env.local` is gitignored.
# For docker-compose dev: most of these are overridden via the root `.env` + docker-compose env_file.

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 48
NEXTAUTH_SECRET=
# Server-side internal URL for CSRF token fetch inside Docker network.
# Set to http://polaris-portal:3000 when running in docker-compose.
# NEXTAUTH_URL_INTERNAL=

# ── SMTP — magic-link delivery ────────────────────────────────────────────────
# Reuses Chatwoot's SMTP. Failure stalls magic-link logins (see ../docs/internal-ops/RUNBOOK.md §portal-mailer-fallback).
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=Polaris <no-reply@getpolaris.my>
MAGIC_LINK_EXPIRY_MIN=15

# ── Polaris API ───────────────────────────────────────────────────────────────
POLARIS_API_BASE_URL=http://localhost:8000
# Server-side override for Docker internal network (falls back to POLARIS_API_BASE_URL if unset).
# POLARIS_API_INTERNAL_URL=http://polaris-api:8000

# ── Session ───────────────────────────────────────────────────────────────────
PORTAL_SESSION_MAX_AGE_S=2592000

# ── Observability ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_ENVIRONMENT=prod
